<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_small"
    android:layout_marginBottom="@dimen/spacing_tiny">

    <!-- Time Period (Day / Month) -->
    <TextView
        android:id="@+id/tv_trend_period"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:text="10 Haz"
        style="@style/TextAppearance.MyApp.Body2"
        android:textColor="@color/text_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Trend Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_trend_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/primary_green_light"
        android:progressBackgroundTint="@color/divider_color"
        android:layout_marginHorizontal="@dimen/spacing_medium"
        app:layout_constraintStart_toEndOf="@id/tv_trend_period"
        app:layout_constraintEnd_toStartOf="@id/tv_trend_amount"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Spent Amount -->
    <TextView
        android:id="@+id/tv_trend_amount"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:text="₺0,00"
        style="@style/TextAppearance.MyApp.Body2"
        android:textStyle="bold"
        android:gravity="end"
        android:textColor="@color/text_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
