<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_small"
    android:layout_marginBottom="@dimen/spacing_small">

    <!-- Category Emoji Icon -->
    <TextView
        android:id="@+id/tv_category_emoji"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="📁"
        android:textSize="20sp"
        android:gravity="center"
        android:background="@drawable/bg_circle_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Category Name -->
    <TextView
        android:id="@+id/tv_category_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:text="Kategori Adı"
        style="@style/TextAppearance.MyApp.Body1"
        android:textStyle="bold"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/tv_category_emoji"
        app:layout_constraintTop_toTopOf="@id/tv_category_emoji"
        app:layout_constraintEnd_toStartOf="@id/tv_category_amount" />

    <!-- Category Percentage -->
    <TextView
        android:id="@+id/tv_category_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="%0"
        style="@style/TextAppearance.MyApp.Caption"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/tv_category_name"
        app:layout_constraintTop_toBottomOf="@id/tv_category_name" />

    <!-- Category Total Amount -->
    <TextView
        android:id="@+id/tv_category_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₺0,00"
        style="@style/TextAppearance.MyApp.Body1"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_category_emoji" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_category_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@android:drawable/progress_horizontal"
        android:progressTint="@color/primary_green"
        android:progressBackgroundTint="@color/divider_color"
        android:layout_marginTop="@dimen/spacing_small"
        app:layout_constraintStart_toStartOf="@id/tv_category_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_category_percentage"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
